# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration
SUPABASE_SECRET_KEY=

# Application
APP_URL=http://localhost:3000
