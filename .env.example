OPENAI_API_KEY=

# Gmail / Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365 OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Protected jobs and encryption
CRON_SECRET=
ENCRYPTION_KEY=
